<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>AliasAgent.Desktop.Tests</AssemblyName>
    <RootNamespace>AliasAgent.Desktop.Tests</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- 三条包全部写死版本（design D6）。测试工程必须**同时**有 Test.Sdk 与
         runner.visualstudio，否则 `dotnet test` 发现不了用例（0 个测试也退出 0）。 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AliasAgent.Desktop\AliasAgent.Desktop.csproj" />
  </ItemGroup>

</Project>
