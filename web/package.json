{
  "name": "alias-agent-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "e2e": "node e2e/smoke.mjs",
    "test": "vitest run",
    "build:harness": "vite build --config vite.harness.config.ts",
    "test:ui": "node e2e/layout.mjs",
    "test:all": "vitest run && npm run build:harness && node e2e/layout.mjs && npm run build && node e2e/group.mjs",
    "e2e:reactions": "node e2e/group_reactions.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "lucide-react": "^1.77.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
